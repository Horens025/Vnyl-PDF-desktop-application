{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vnyl",
  "version": "0.8.0",
  "identifier": "com.vnyl.viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vnyl",
        "width": 1200,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A world-class, open-source PDF viewer",
    "longDescription": "Vnyl is a fast, accessible, extensible, dark-mode-native PDF viewer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./installer.nsh",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Horens025/Vnyl-PDF-desktop-application/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IDc5N0Q5MzMxNUYxQkI5QkUKUldTK3VSdGZNWk45ZVdIVmRPNUhoVjA0QSs1VnBIUlgvMHBReVFNV0c5MHlpQm91eWk2NVdwNlMK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["vnyl"]
      }
    }
  }
}
