{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main Vnyl window.",
  "windows": ["main", "extra-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "process:allow-restart",
    "updater:default",
    "deep-link:default"
  ]
}
